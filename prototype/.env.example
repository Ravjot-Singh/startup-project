# Copy to .env and fill in. On Render, set the same names under the service's Environment tab.
# Check a configuration at any time with:  python -m app.check

# ---------- The basics ----------

# "development" (your computer) or "production" (the live server).
# Production refuses to start with weak or missing secrets and says which one.
APP_ENV=development
# All dates and times use this zone, whatever the server clock says
TIMEZONE=Asia/Kolkata

# ---------- Database ----------

# Postgres connection string from Neon (Dashboard -> Connect), e.g.
#   postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Leave it empty to use a local file instead (prototype/reminders.db, SQLite).
# Required in production.
# Careful: with the live Neon string here, the app on your computer reads and changes the live data.
# Its automatic sending stays off unless you set LOCAL_SCHEDULER=true below, so it won't send alongside
# the server. The tests never use this database.
DATABASE_URL=

# ---------- Login ----------

# The owner's login. In production the password needs 10+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# A long random string (32+ characters in production). Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- Your business ----------

# Shown in messages, bill PDFs and the catalogue
BUSINESS_NAME=ABC Frozen Foods
# Used for the "pay by UPI" link and the QR code on bills
BUSINESS_UPI_ID=abcfrozen@okaxis

# ---------- Automatic sending ----------

# Secret for POST /jobs/tick, sent by cron-job.org in the X-Tick-Token header (24+ characters).
# Empty = that endpoint is switched off. Make one the same way as SESSION_SECRET.
TICK_TOKEN=
# Run the tick on a built-in timer every 10 min. On by default only when DATABASE_URL is empty
# (local SQLite); always off in production, where cron-job.org calls /jobs/tick instead.
# LOCAL_SCHEDULER=true

# Starting values for the daily send time and sending hours (24h, India time).
# After the first run the owner changes these on the Settings page, and those values win.
REMINDER_RUN_HOUR=10
SEND_WINDOW_START=9
SEND_WINDOW_END=20

# ---------- WhatsApp (Meta Cloud API) ----------

# "dryrun" = test mode: every message is written and listed on the Messages page, nothing is sent.
# "meta"   = really send on WhatsApp (needs the four values below). See docs/go-live.md.
WHATSAPP_PROVIDER=dryrun
# Meta Business Settings -> System users -> Generate token (permanent; permission whatsapp_business_messaging)
META_WA_TOKEN=
# Meta App -> WhatsApp -> API Setup -> "Phone number ID" (an ID, not the phone number)
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE_LANG=en
# Any random string you choose; type the same one as the "Verify token" in Meta's webhook settings
META_WA_VERIFY_TOKEN=change-me
# Meta App -> App settings -> Basic -> App secret (proves webhook calls really come from Meta)
META_APP_SECRET=
