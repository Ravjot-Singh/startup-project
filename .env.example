# Copy to .env and fill in.

# "development" or "production". Production refuses to start with weak/default secrets.
APP_ENV=development
# All dates and times use this zone, whatever the server clock says
TIMEZONE=Asia/Kolkata

# SQLite for local dev; use postgresql+psycopg://user:pass@host/db in production
DATABASE_URL=sqlite:///./reminders.db

# Distributor details shown in messages
BUSINESS_NAME=ABC Frozen Foods
BUSINESS_UPI_ID=abcfrozen@okaxis

# Defaults for the reminder run hour and sending window (24h, business time).
# Once the app has run, the values stored in the database settings take precedence.
REMINDER_RUN_HOUR=10
SEND_WINDOW_START=9
SEND_WINDOW_END=20

# WhatsApp provider: "dryrun" (logs only, nothing is sent) or "meta"
WHATSAPP_PROVIDER=dryrun
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE_LANG=en
# Token you choose; must match what you enter in the Meta webhook settings
META_WA_VERIFY_TOKEN=change-me
# Meta App Dashboard -> App settings -> Basic -> App secret (verifies webhook signatures)
META_APP_SECRET=

# Secret for POST /jobs/tick (sent by the external cron in the X-Tick-Token header). Empty = endpoint off.
TICK_TOKEN=
# Run the tick on an in-process timer every 10 min (on by default outside production)
# LOCAL_SCHEDULER=true

# Simple login for the dashboard (replace with proper users/roles later)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
